# USSD Payment Configuration

# M-Pesa Settings (Safaricom)
MPESA_CONSUMER_KEY=your_mpesa_consumer_key
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret
MPESA_BUSINESS_SHORTCODE=174379
MPESA_PASSKEY=your_mpesa_passkey
MPESA_INITIATOR=your_initiator_username
MPESA_INITIATOR_PASSWORD=your_initiator_password
MPESA_SANDBOX=true

# Yas Settings (Tanzania)
YAS_API_KEY=your_yas_api_key
YAS_API_SECRET=your_yas_api_secret
YAS_MERCHANT_ID=your_yas_merchant_id
YAS_API_URL=https://api.yas.co.tz

# Airtel Settings
AIRTEL_API_KEY=your_airtel_api_key
AIRTEL_API_SECRET=your_airtel_api_secret
AIRTEL_MERCHANT_ID=your_airtel_merchant_id
AIRTEL_API_URL=https://api.airtel.co.tz

# Halotel Settings
HALOTEL_API_KEY=your_halotel_api_key
HALOTEL_API_SECRET=your_halotel_api_secret
HALOTEL_MERCHANT_ID=your_halotel_merchant_id
HALOTEL_API_URL=https://api.halotel.co.tz
